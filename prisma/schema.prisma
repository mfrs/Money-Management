generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  currency  String   @default("IDR")
  theme     String   @default("dark")  // dark, light
  pin       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastOnline DateTime? @default(now())

  wallets          Wallet[]
  categories       Category[]
  journals         Journal[]
  incomeSources    IncomeSource[]
  fixedExpenses    FixedExpense[]
  walletAllocations WalletAllocation[]
  goals            Goal[]
  assets           Asset[]
  debts            Debt[]

  @@map("users")
}

model Wallet {
  id        String   @id @default(cuid())
  name      String
  type      String   // bank, ewallet, cash, savings
  account   String   @default("")
  balance   Float    @default(0)
  icon      String   @default("Wallet")
  color     String   @default("#3B82F6")
  goal      Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  journalLines    JournalLine[]
  allocations     WalletAllocation[]

  @@map("wallets")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   // expense, income
  icon        String   @default("HelpCircle")
  color       String   @default("#3B82F6")
  budgetLimit Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  journalLines JournalLine[]

  @@map("categories")
}

model Journal {
  id          String   @id @default(cuid())
  seqId       Int      @default(autoincrement()) @unique
  date        DateTime
  description String
  note        String   @default("")
  isReversed  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lines JournalLine[]

  @@map("journals")
}

model JournalLine {
  id          String   @id @default(cuid())
  journalId   String
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  
  walletId    String?
  wallet      Wallet?  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  amount      Float
  type        String   // DEBIT, CREDIT
  createdAt   DateTime @default(now())

  @@map("journal_lines")
}

model IncomeSource {
  id     String @id @default(cuid())
  name   String
  amount Float  @default(0)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("income_sources")
}

model FixedExpense {
  id        String    @id @default(cuid())
  name      String
  amount    Float     @default(0)
  term      String    @default("01-MONTH")
  icon      String    @default("CreditCard")
  autoPay   Boolean   @default(false)
  dueDate   Int?      // Day of the month 1-31
  lastPaid  DateTime?
  status    String    @default("active") // active, paused

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fixed_expenses")
}

model WalletAllocation {
  id       String @id @default(cuid())
  amount   Float  @default(0)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_allocations")
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  icon          String    @default("Target")
  color         String    @default("#10B981")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

model Asset {
  id             String   @id @default(cuid())
  name           String
  type           String   // investment, property, vehicle, gold, other
  purchasePrice  Float
  currentPrice   Float
  purchaseDate   DateTime
  estimatedRate  Float    @default(0) // Annual appreciation (+) or depreciation (-) rate in percent
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assets")
}

model Debt {
  id              String    @id @default(cuid())
  title           String
  type            String    // DEBT or RECEIVABLE
  contact         String
  amount          Float
  remainingAmount Float
  dueDate         DateTime?
  interestRate    Float     @default(0)
  notes           String    @default("")
  status          String    @default("ACTIVE") // ACTIVE or PAID
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  walletId        String?

  @@map("debts")
}

model Changelog {
  id          String   @id @default(cuid())
  version     String   // e.g., "v1.2.0"
  title       String
  content     String   // Markdown support
  isPublished Boolean  @default(false)
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("changelogs")
}
